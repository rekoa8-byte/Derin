rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Store data shared across all customer and admin links
    match /store/{docId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
